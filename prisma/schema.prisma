datasource db {
  provider  = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// NextAuth & User Models
// ==========================================

enum UserRole {
  CUSTOMER
  ADMIN
  DELIVERY_PARTNER
}

model User {
  id            String          @id @default(cuid())
  name          String?
  email         String          @unique
  emailVerified DateTime?
  image         String?
  password      String?         // Hashed password for credentials auth
  phone         String?
  role          UserRole        @default(CUSTOMER)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  accounts      Account[]
  sessions      Session[]
  addresses     Address[]
  orders        Order[]
  reviews       Review[]
  favorites     Favorite[]
  notifications Notification[]
  
  // Link to DeliveryPartner profile if role is DELIVERY_PARTNER
  deliveryProfile DeliveryPartner?
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ==========================================
// Restaurant & Menu Models
// ==========================================

model Restaurant {
  id           String     @id @default(cuid())
  name         String
  description  String
  address      String
  image        String     // Cloudinary image URL
  rating       Float      @default(0.0)
  deliveryTime Int        @default(30) // estimated delivery time in minutes
  deliveryFee  Float      @default(0.0)
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  menuItems    MenuItem[]
  orders       Order[]
  reviews      Review[]
  favorites    Favorite[]
}

model Category {
  id          String     @id @default(cuid())
  name        String     @unique
  image       String     // Cloudinary image URL
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  menuItems   MenuItem[]
}

model MenuItem {
  id           String     @id @default(cuid())
  name         String
  description  String
  price        Float
  image        String     // Cloudinary image URL
  isVeg        Boolean    @default(true)
  isBestseller Boolean    @default(false)
  available    Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  categoryId   String
  category     Category   @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  orderItems   OrderItem[]
}

// ==========================================
// Orders & Cart Models
// ==========================================

enum OrderStatus {
  PLACED
  CONFIRMED
  PREPARING
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model Order {
  id             String        @id @default(cuid())
  orderNumber    String        @unique // Human readable short id
  status         OrderStatus   @default(PLACED)
  totalAmount    Float         // sum of items * quantities
  deliveryFee    Float         @default(0.0)
  discountAmount Float         @default(0.0)
  finalAmount    Float         // total + deliveryFee - discount
  paymentStatus  PaymentStatus @default(PENDING)
  paymentMethod  String        @default("STRIPE") // STRIPE or COD
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  restaurantId   String
  restaurant     Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Restrict)

  addressId      String
  address        Address       @relation(fields: [addressId], references: [id], onDelete: Restrict)

  deliveryPartnerId String?
  deliveryPartner   DeliveryPartner? @relation(fields: [deliveryPartnerId], references: [id], onDelete: SetNull)

  items          OrderItem[]
  payment        Payment?
  reviews        Review[]
}

model OrderItem {
  id        String   @id @default(cuid())
  quantity  Int
  price     Float    // Price of the item at the time of order
  customizations String? // JSON string for chosen preferences (e.g. extra cheese)

  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  menuItemId String
  menuItem  MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
}

// ==========================================
// Address, Review & Favorite Models
// ==========================================

model Address {
  id         String   @id @default(cuid())
  title      String   // Home, Office, Other
  street     String
  city       String
  state      String
  postalCode String
  country    String   @default("India")
  phone      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  orders     Order[]
}

model Review {
  id           String      @id @default(cuid())
  rating       Int         // 1 to 5 stars
  comment      String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  restaurantId String
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  orderId      String?
  order        Order?      @relation(fields: [orderId], references: [id], onDelete: SetNull)
}

model Favorite {
  id           String      @id @default(cuid())
  createdAt    DateTime    @default(now())

  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  restaurantId String
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([userId, restaurantId])
}

// ==========================================
// Coupon & Payment Models
// ==========================================

enum DiscountType {
  PERCENTAGE
  FLAT
}

model Coupon {
  id             String       @id @default(cuid())
  code           String       @unique
  discountType   DiscountType @default(PERCENTAGE)
  discountValue  Float
  minOrderAmount Float        @default(0.0)
  maxDiscount    Float?       // limit for percentage discounts
  expiresAt      DateTime
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Payment {
  id             String        @id @default(cuid())
  stripeSessionId String?      @unique
  amount         Float
  status         PaymentStatus @default(PENDING)
  method         String        @default("STRIPE")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  orderId        String        @unique
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// ==========================================
// Delivery Partner Profile
// ==========================================

enum DeliveryPartnerStatus {
  AVAILABLE
  BUSY
  OFFLINE
}

model DeliveryPartner {
  id            String                @id @default(cuid())
  vehicleType   String?               // bike, cycle, car
  vehicleNumber String?
  status        DeliveryPartnerStatus @default(OFFLINE)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  userId        String                @unique
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  orders        Order[]
}

// ==========================================
// Notifications Model
// ==========================================

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
